# Copier ce fichier en « .env » puis adapter.

# Mot de passe de l'espace direction. Obligatoire.
ADMIN_PASSWORD=changez-moi

# Port d'écoute.
PORT=3000

# Emplacement du coffre (originaux, aperçus, base). Chemin absolu conseillé
# en production : c'est le seul dossier à sauvegarder.
STORAGE_DIR=coffre

# Force du flou des aperçus : 12 = doux, 20 = recommandé, 30 = très opaque.
BLUR_SIGMA=20

# Taille max des aperçus affichés / des vignettes de la grille (pixels).
PREVIEW_MAX=1400
THUMB_MAX=520

# Limites de dépôt.
MAX_FILE_MB=80
MAX_FILES_PER_UPLOAD=40

# Nom affiché dans l'interface et dans le filigrane.
BRAND=Maison Audou

# En production derrière HTTPS.
NODE_ENV=production
SECURE_COOKIES=true

# Laisser vide : un secret est généré et conservé dans le coffre.
SESSION_SECRET=
